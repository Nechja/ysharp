// Tagged-union enums with construction + destructuring in match.

enum Status {
    Pending;
    Active;
    Suspended;
}

enum OrderStatus {
    Created;
    Shipped { tracking: string; };
    Delivered { receipt: int; };
}

fn describe(s: OrderStatus) -> string ~blocking {
    return match s {
        OrderStatus.Created => "waiting";
        OrderStatus.Shipped(t) => $"out for delivery, tracking={t}";
        OrderStatus.Delivered(r) => $"delivered, receipt={r}";
    };
}

fn main() -> void {
    let s = Status.Active;
    print($"plain: {s}");

    print(describe(OrderStatus.Created));
    print(describe(OrderStatus.Shipped("1Z999")));
    print(describe(OrderStatus.Delivered(42)));
}
