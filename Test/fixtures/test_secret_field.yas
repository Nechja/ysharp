// `~secret` fields exist on the record but won't appear in serialized JSON.
// At the interpreter level the field is still accessible -- only serialization redacts.

record User {
    id: int;
    name: string;
    passwordHash: string ~secret;
}

fn main() -> void {
    let u = User(1, "kayla", "deadbeef");
    print($"{u.id} {u.name} hash={u.passwordHash}");
}
