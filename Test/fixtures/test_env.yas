// `env(name)` reads an env var. Returns null when unset.
// Common idiom: `env("FOO") ?? "default"` -- but Y# doesn't have ??, so
// for now just print the raw lookup of an unset name.

fn main() -> void {
    let v = env("YSHARP_FIXTURE_PROBABLY_UNSET");
    if v == null {
        print("unset");
    } else {
        print("set");
    }
}
