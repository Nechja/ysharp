// Exercise the built-in Result<T> + Error variants that the HTTP wrapper
// (when routes are present) maps to status codes.

fn lookup(id: int) -> Result<string> {
    if id == 1 {
        return "alpha";
    }
    if id == 2 {
        return Error.Validation("id 2 is reserved");
    }
    return Error.NotFound($"no entry for id {id}");
}

fn main() -> void {
    print(lookup(1));
    print(lookup(2));
    print(lookup(999));
}
